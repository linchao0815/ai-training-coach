# 複製成 .env（已加入 .gitignore）並填入你自己的帳密。
# fetch_training_data.py / create_workouts.py / fetch_garmin_data.py / create_garmin_workouts.py
# 都會透過 coros_runner.py / garmin_auth.py 的 _load_dotenv_defaults() 自動讀取這個檔案。

COROS_EMAIL=
COROS_PASSWORD=
# 一定要設，不設會預設打 eu 區域伺服器，導致登入成功但所有查詢都回
# "Access token is invalid"（看起來像帳號問題，其實是打錯區域）。
# 依你的帳號實際註冊地區設定，例如 asia 或 eu。
COROS_REGION=

GARMIN_EMAIL=
GARMIN_PASSWORD=
